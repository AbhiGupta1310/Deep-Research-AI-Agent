# Render Deployment Configuration
# Copy this to your Render environment variables

# LLM Model Configuration (OpenRouter)
OPENROUTER_API_KEY=your_key_here
LLM_MODEL_CHEAP=google/gemini-2.0-flash
LLM_MODEL_MID=anthropic/claude-3.5-haiku
LLM_MODEL_PREMIUM=anthropic/claude-3.5-sonnet

# Search API Keys
TAVILY_API_KEY=your_key_here
SERPER_API_KEY=your_key_here

# Redis Cache (required for production)
REDIS_URL=redis://:password@your-redis-host:6379

# Environment Flag for Render
RENDER=true
PRODUCTION=true

# Memory optimization settings
PYTHONUNBUFFERED=1
PYTHONHASHSEED=0
